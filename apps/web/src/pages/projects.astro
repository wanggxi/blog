---
import SiteLayout from "../layouts/SiteLayout.astro";
import { contentClient } from "../lib/content-client";
import { loadHomeContent } from "../lib/load-content";

const { projects, offline } = await loadHomeContent(contentClient);
---

<SiteLayout title="Projects" description="产品、实验和持续建设中的项目。">
	<header class="page-shell">
		<p class="eyebrow">Products / Experiments / Open work</p>
		<h1 class="page-heading">项目</h1>
		<p class="lead">把想法变成可以被使用、检验和继续迭代的东西。</p>
	</header>
	<section class="section">
		{
			projects.length > 0 ? (
				<div class="project-grid">
					{projects.map((project) => (
						<article class="project-card">
							<div class="meta">{project.year} / {project.platform} / {project.status}</div>
							<h2>{project.name}</h2>
							<p>{project.description}</p>
							<div class="tag-list">{project.tags.map((tag) => <span>#{tag}</span>)}</div>
							{project.liveUrl && <p><a href={project.liveUrl}>访问项目 ↗</a></p>}
						</article>
					))}
				</div>
			) : (
				<div class="empty-state">{offline ? "内容服务尚未连接。" : "还没有发布项目。"}</div>
			)
		}
	</section>
</SiteLayout>
