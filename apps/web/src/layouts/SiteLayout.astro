---
import "../styles/global.css";

type Props = {
	description?: string;
	title: string;
};

const { description = "A personal site built with Astro", title } = Astro.props;
const pageTitle = `${title} · Personal Index`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light dark" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳到正文</a>
		<div class="site-frame">
			<header class="site-header">
				<a class="wordmark" href="/" aria-label="Personal Index home">
					<span aria-hidden="true">◆</span>
					<span>PERSONAL INDEX</span>
				</a>
				<nav aria-label="Primary navigation">
					<a href="/blog">文章</a>
					<a href="/projects">项目</a>
					<a href="/about">关于</a>
				</nav>
			</header>

			<main id="main-content">
				<slot />
			</main>

			<footer class="site-footer">
				<span>ASTRO / PAYLOAD / POSTGRESQL</span>
				<span>CONTENT, BUILT TO LAST.</span>
			</footer>
		</div>
	</body>
</html>
