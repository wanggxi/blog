# Shared public URLs
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_CMS_URL=http://localhost:3000
INTERNAL_CMS_URL=http://cms:3000

# PostgreSQL (replace every example value outside Git)
DATABASE_URL=postgresql://blog:replace-me@postgres:5432/blog

# Authentication and internal request signing
PAYLOAD_SECRET=generate-a-random-64-byte-value
PREVIEW_SECRET=generate-a-different-random-64-byte-value
CACHE_INVALIDATION_SECRET=generate-a-third-random-64-byte-value
TOTP_ENCRYPTION_KEY=generate-a-32-byte-base64-value

# S3-compatible media storage (Cloudflare R2 in production)
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=blog-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
MEDIA_PUBLIC_URL=http://localhost:9000/blog-media

# Deployment hostnames
SITE_HOST=localhost
ADMIN_HOST=admin.localhost
API_HOST=api.localhost
